# extract_T_orders.lsf
# 在 build_905nm_supercell.lsf 建立的模型完成 Run 后执行本脚本。
# 监视器名称固定为 T；输出侧为 SiO2 基底，能流方向为 -z。

monitor_name = "T";
output_index = 1.45;       # 必须与 build 脚本中的 n_SiO2 保持一致
projection_direction = -1; # 基底侧透射光沿 -z 传播
frequency_index = 1;       # 单波长 905 nm 仿真只有一个频率点

# 每组结构运行前修改编号；结果将分别写入 T_orders_<sample_id>.txt / .ldf。
sample_id = "case_001";

# 各级次相对总透射功率的比例 G，以及总透射功率 T_total。
G = grating(monitor_name, frequency_index, output_index, projection_direction);
N = gratingn(monitor_name, frequency_index, output_index, projection_direction);
M = gratingm(monitor_name, frequency_index, output_index, projection_direction);
T_total = abs(pinch(transmission(monitor_name)));

# gratingvector 返回每个级次的复电场矢量 [Ex,Ey,Ez]。
# 当前源为 x 偏振，且所有目标级次均 m=0，因此使用复 Ex 提取相位。
Gv = gratingvector(monitor_name, frequency_index, output_index, projection_direction);

ix_m1 = find(N,-1);
ix_0  = find(N, 0);
ix_p1 = find(N, 1);
iy_0  = find(M, 0);

# 效率 eta_N = 该级次在总透射中的份额 x 总透射效率。
eta_m1 = pinch(G(ix_m1,iy_0,frequency_index))*T_total;
eta_0  = pinch(G(ix_0, iy_0,frequency_index))*T_total;
eta_p1 = pinch(G(ix_p1,iy_0,frequency_index))*T_total;

# 复 Ex 投影和相位；相位范围为 [-pi,pi]。
# 只要所有 library 单元使用同一 T 位置、同一 source 与同一投影方向，
# 这些相位可以直接进行相对比较；每个级次的固定整体相位可视为常数偏置。
A_m1 = pinch(Gv(ix_m1,iy_0,frequency_index,1));
A_0  = pinch(Gv(ix_0, iy_0,frequency_index,1));
A_p1 = pinch(Gv(ix_p1,iy_0,frequency_index,1));

phi_m1 = angle(A_m1);
phi_0  = angle(A_0);
phi_p1 = angle(A_p1);

# 行：N=-1,0,+1；列：级次编号、效率 eta_N、相位 phi_N[rad]。
order_results = [-1, eta_m1, phi_m1;
                  0, eta_0,  phi_0;
                  1, eta_p1, phi_p1];

order_amplitudes = [-1, real(A_m1), imag(A_m1);
                     0, real(A_0),  imag(A_0);
                     1, real(A_p1), imag(A_p1)];

?("Columns: order, eta_N, phi_N [rad]");
?order_results;

# 每个 sample_id 覆盖其同名结果，防止重复追加同一组数据。
result_txt = "T_orders_" + sample_id + ".txt";
write(result_txt, "Columns: order, eta_N, phi_N_rad", "overwrite");
write(result_txt, num2str(order_results), "append");

result_ldf = "T_orders_" + sample_id;
savedata(result_ldf, order_results, order_amplitudes, eta_m1, eta_0, eta_p1, phi_m1, phi_0, phi_p1);

?("Saved: " + result_txt + " and " + result_ldf + ".ldf");
