# analysis_group_T_orders_script.lsf
# 粘贴位置：analysis group -> Analysis -> Script
#
# Sweep 的唯一输出：
# eta_m1、eta_0、eta_p1、phi_m1、phi_0、phi_p1。
# 监视器 T 位于本 Analysis Group 内；输出介质为 SiO2（n=1.45），
# 透射光沿 -z 传播，使用复 Ex 的相位。

monitor_name = "T";
output_index = 1.45;
projection_direction = -1;
frequency_index = 1;
projected_f_slot = 1;

# 总透射率相对于入射功率的比例。
T_all = transmission(monitor_name);
T_total = abs(pinch(T_all(frequency_index)));

# grating：N x M x P；gratingvector：N x M x P x 3（Ex、Ey、Ez）。
G = grating(monitor_name,frequency_index,output_index,projection_direction);
N = gratingn(monitor_name,frequency_index,output_index,projection_direction);
M = gratingm(monitor_name,frequency_index,output_index,projection_direction);
Gv = gratingvector(monitor_name,frequency_index,output_index,projection_direction);

# 精确寻找 (N,M)=(-1,0)、(0,0)、(+1,0)。
ix_m1 = find(N==-1);
ix_0  = find(N==0);
ix_p1 = find(N==1);
iy_0  = find(M==0);

# 固定标量输出；若目标级次不存在，结果保持为 0 并在 Script Prompt 提示。
eta_m1 = 0;
eta_0  = 0;
eta_p1 = 0;
phi_m1 = 0;
phi_0  = 0;
phi_p1 = 0;

if ((ix_m1==0) | (ix_0==0) | (ix_p1==0) | (iy_0==0)) {
    ?"Warning: one or more target diffraction orders are not propagating.";
} else {
    # 相对于入射功率的目标级次效率。
    eta_m1 = real(pinch(G(ix_m1,iy_0,projected_f_slot)))*T_total;
    eta_0  = real(pinch(G(ix_0, iy_0,projected_f_slot)))*T_total;
    eta_p1 = real(pinch(G(ix_p1,iy_0,projected_f_slot)))*T_total;

    # 复 Ex 分量及相位，统一映射到 [0,2*pi)。
    A_m1 = pinch(Gv(ix_m1,iy_0,projected_f_slot,1));
    A_0  = pinch(Gv(ix_0, iy_0,projected_f_slot,1));
    A_p1 = pinch(Gv(ix_p1,iy_0,projected_f_slot,1));

    phi_m1 = mod(angle(A_m1),2*pi);
    phi_0  = mod(angle(A_0), 2*pi);
    phi_p1 = mod(angle(A_p1),2*pi);
}
