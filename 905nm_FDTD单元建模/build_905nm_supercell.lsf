# build_905nm_supercell.lsf
# Ansys Lumerical FDTD Solutions
#
# 用途：建立 905 nm 正入射、TiO2/SiO2 双柱非对称 supercell 的 FDTD 模型。
# 此模型用于建立 C_-1、C_0、C_+1 的单元库，不是完整 27 um x 27 um 超表面。
#
# 运行前：请在一个新的、空白的 FDTD 工程中运行本脚本。
# 本脚本不执行 newproject、delete 或 run，因此不会清空已有工程，也不会自动开始耗时仿真。

###############################################################################
# 1. 设计参数（SI 单位）
###############################################################################
lambda0 = 905e-9;       # 真空波长
Sx      = 1350e-9;      # x 向 supercell 周期
Sy      = 450e-9;       # y 向 supercell 周期

# 第一版材料近似。完成初步验证后，必须替换为实际薄膜椭偏得到的 n,k 色散。
n_TiO2 = 2.30;
n_SiO2 = 1.45;

# TiO2 双柱第一版几何；两个柱的不同半径、不同 x 位置打破 x 镜像对称性。
# 后续 parameter sweep 应扫描 pillar1_radius、pillar2_radius、
# pillar1_x、pillar2_x 和 pillar_height。
# 不使用 h、x1、y1 等名称，避免与 Lumerical 内置常量冲突。
pillar_height = 650e-9;       # TiO2 柱高
pillar1_radius = 95e-9;       # pillar_1 半径
pillar2_radius = 145e-9;      # pillar_2 半径
pillar1_x = -260e-9;          # pillar_1 中心 x 坐标
pillar2_x =  210e-9;          # pillar_2 中心 x 坐标
pillar1_y = 0;
pillar2_y = 0;

# z 向布局：光从 SiO2 基底侧（-z）正入射，向空气侧（+z）透射。
t_sub       = 1000e-9;  # 基底在仿真域内的厚度
air_above   = 850e-9;   # 柱顶至 z-max PML 的空气厚度
z_source    = -600e-9;  # source 位于均匀 SiO2 区域
z_T_monitor =  950e-9;  # T monitor 位于均匀空气区域

###############################################################################
# 2. FDTD 求解区域：x/y 周期边界，z 向 PML
###############################################################################
# 首次运行时新建 FDTD；若上次因脚本报错已留下默认 FDTD 求解器，则复用它。
if (getnamednumber("FDTD")==0) {
    addfdtd;
} else {
    select("FDTD");
}
set("dimension",2);          # Lumerical 枚举值：2 表示 3D
set("x",0);
set("x span",Sx);
set("y",0);
set("y span",Sy);
set("z min",-t_sub);
set("z max",pillar_height+air_above);
set("x min bc","Periodic");
set("x max bc","Periodic");
set("y min bc","Periodic");
set("y max bc","Periodic");
set("z min bc","PML");
set("z max bc","PML");
set("mesh accuracy",3);
set("simulation time",2000e-15);
set("auto shutoff min",1e-5);

# 对 +/-42 deg 的衍射级次，建议在 FDTD GUI 的 Advanced Options 中将
# PML profile 设为 Steep angle；不同版本的属性名称可能不同，故不在此强制设置。

###############################################################################
# 3. 重跑保护：仅删除本脚本已创建的同名对象，保留 FDTD 求解器
###############################################################################
if (getnamednumber("SiO2_substrate")>0) {
    select("SiO2_substrate"); delete;
}
if (getnamednumber("TiO2_pillar_1")>0) {
    select("TiO2_pillar_1"); delete;
}
if (getnamednumber("TiO2_pillar_2")>0) {
    select("TiO2_pillar_2"); delete;
}
if (getnamednumber("mesh_pillars")>0) {
    select("mesh_pillars"); delete;
}
if (getnamednumber("source_905nm")>0) {
    select("source_905nm"); delete;
}
if (getnamednumber("T_air")>0) {
    select("T_air"); delete;
}

###############################################################################
# 4. 材料与结构：SiO2 基底 + 两根 TiO2 圆柱
###############################################################################
addrect;
set("name","SiO2_substrate");
set("x",0);
set("x span",Sx);
set("y",0);
set("y span",Sy);
set("z min",-t_sub);
set("z max",0);
set("material","<Object defined dielectric>");
set("index",n_SiO2);

addcircle;
set("name","TiO2_pillar_1");
set("x",pillar1_x);
set("y",pillar1_y);
set("radius",pillar1_radius);
set("z min",0);
set("z max",pillar_height);
set("material","<Object defined dielectric>");
set("index",n_TiO2);

addcircle;
set("name","TiO2_pillar_2");
set("x",pillar2_x);
set("y",pillar2_y);
set("radius",pillar2_radius);
set("z min",0);
set("z max",pillar_height);
set("material","<Object defined dielectric>");
set("index",n_TiO2);

###############################################################################
# 5. 网格：仅在结构邻域使用 10 nm override mesh
###############################################################################
addmesh;
set("name","mesh_pillars");
set("x",0);
set("x span",Sx);
set("y",0);
set("y span",Sy);
set("z min",-50e-9);
set("z max",pillar_height+50e-9);
set("override x mesh",1);
set("override y mesh",1);
set("override z mesh",1);
set("dx",10e-9);
set("dy",10e-9);
set("dz",10e-9);

###############################################################################
# 6. 905 nm 平面波正入射
###############################################################################
addplane;
set("name","source_905nm");
set("injection axis","z");
set("direction","Forward");
set("x",0);
set("x span",Sx);
set("y",0);
set("y span",Sy);
set("z",z_source);
set("wavelength start",lambda0);
set("wavelength stop",lambda0);
set("polarization angle",0);  # x 偏振；后续可改为 90 deg 做 y 偏振对照

###############################################################################
# 7. 空气侧频域监视器：用于 grating() 提取 (-1,0,+1) 级次效率
###############################################################################
adddftmonitor;
set("name","T_air");
set("monitor type",7);  # 2D Z-normal monitor
set("x",0);
set("x span",Sx);
set("y",0);
set("y span",Sy);
set("z",z_T_monitor);

###############################################################################
# 8. 运行后的级次效率提取（复制到 Script Prompt 或取消注释后运行）
###############################################################################
# run;
#
# T = transmission("T_air"); # 总透射功率 / 入射功率
# N = gratingn("T_air");     # x 向衍射级次编号
# M = gratingm("T_air");     # y 向衍射级次编号
# G = grating("T_air");      # 每个级次占总透射功率的比例
#
# ix_m1 = find(N,-1);  ix_0 = find(N,0);  ix_p1 = find(N,1);
# iy_0  = find(M,0);
#
# eta_m1 = pinch(G(ix_m1,iy_0,1))*pinch(T(1));
# eta_0  = pinch(G(ix_0, iy_0,1))*pinch(T(1));
# eta_p1 = pinch(G(ix_p1,iy_0,1))*pinch(T(1));
#
# ?("Transmission efficiency: eta_-1 = "+num2str(eta_m1));
# ?("Transmission efficiency: eta_0  = "+num2str(eta_0));
# ?("Transmission efficiency: eta_+1 = "+num2str(eta_p1));
#
# 说明：grating() 给出功率效率。建立 library 时还需利用 T_air 的复电场
# 或 gratingpolar()/gratingvector() 提取各级次复振幅及相位 C_N。
